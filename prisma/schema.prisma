generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuizEvent {
  id             String     @id @default(uuid())
  name           String
  durationSec    Int
  questionCount  Int
  passPercent    Int
  status                String     @default("ACTIVE")
  allowMultipleAttempts Boolean    @default(false)
  createdAt             DateTime   @default(now())
  questions             Question[]
  attempts              Attempt[]
  yearConfigs           EventYearConfig[]
}

model EventYearConfig {
  id             String    @id @default(uuid())
  eventId        String
  event          QuizEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  year           String    // "FY", "SY", "TY", "LY"
  easyCount      Int       @default(2)
  mediumCount    Int       @default(2)
  hardCount      Int       @default(1)
  excludedTopics String    @default("")
  
  @@unique([eventId, year])
}

model Question {
  id              String            @id @default(uuid())
  eventId         String
  text            String
  imageUrl        String?
  durationSec     Int?
  difficulty      String
  topic           String
  targetYear      String            @default("ALL") // "FY", "SY", "TY", "LY", "ALL"
  status          String            @default("ACTIVE")
  uploadBatchId   String?           // Links question to an upload batch
  event           QuizEvent         @relation(fields: [eventId], references: [id])
  options         Option[]
  attemptQuestions AttemptQuestion[]
  uploadBatch     UploadHistory?    @relation(fields: [uploadBatchId], references: [id], onDelete: Cascade)
  
  @@index([eventId, difficulty, status])
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  text       String
  optionKey  String
  isCorrect  Boolean
  question   Question @relation(fields: [questionId], references: [id])
  answers    Answer[]
}

model Participant {
  id         String     @id @default(uuid())
  name       String
  email      String     @unique
  mobile     String
  year       String
  prn        String?
  createdAt  DateTime   @default(now())
  attempts   Attempt[]
  coupons    Coupon[]
}

model Attempt {
  id             String            @id @default(uuid())
  participantId  String
  eventId        String
  targetYear     String?
  status         String            @default("ACTIVE")
  startedAt      DateTime          @default(now())
  deadlineAt     DateTime
  submittedAt    DateTime?
  scorePercent   Float?
  participant    Participant       @relation(fields: [participantId], references: [id])
  event          QuizEvent         @relation(fields: [eventId], references: [id])
  questions      AttemptQuestion[]
  answers        Answer[]
  coupon         Coupon?

  @@index([participantId, eventId, status])
}

model AttemptQuestion {
  id          String    @id @default(uuid())
  attemptId   String
  questionId  String
  position    Int
  servedAt    DateTime?
  deadlineAt  DateTime?
  answeredAt  DateTime?
  attempt     Attempt   @relation(fields: [attemptId], references: [id])
  question    Question  @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@unique([attemptId, position])
  @@index([attemptId, answeredAt, position])
}

model Answer {
  id               String   @id @default(uuid())
  attemptId        String
  questionId       String
  selectedOptionId String
  isCorrect        Boolean
  submittedAt      DateTime @default(now())
  attempt          Attempt  @relation(fields: [attemptId], references: [id])
  option           Option   @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
}

model Coupon {
  id            String      @id @default(uuid())
  code          String      @unique
  attemptId     String      @unique
  participantId String
  status        String      @default("ISSUED")
  issuedAt      DateTime    @default(now())
  redeemedAt    DateTime?
  redeemedBy    String?
  attempt       Attempt     @relation(fields: [attemptId], references: [id])
  participant   Participant @relation(fields: [participantId], references: [id])
}

model AuditLog {
  id         String   @id @default(uuid())
  actor      String
  action     String
  entityType String
  entityId   String
  metadata   String?  // Using String for SQLite since it doesn't support JSON
  createdAt  DateTime @default(now())
}

model SyncJob {
  id          String    @id @default(uuid())
  type        String    // GOOGLE_SHEETS
  payload     String    // Stored as stringified JSON since SQLite doesn't have Json type
  status      String    @default("PENDING") // PENDING, COMPLETED, FAILED
  attempts    Int       @default(0)
  nextRetryAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model UploadHistory {
  id             String     @id @default(uuid())
  filename       String
  questionCount  Int
  uploadedBy     String     @default("System")
  createdAt      DateTime   @default(now())
  questions      Question[]
}

model Admin {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("CO_ADMIN") // SUPER_ADMIN or CO_ADMIN
  createdAt DateTime @default(now())
}

model ScannerSession {
  id        String   @id @default(uuid())
  adminId   String
  status    String   @default("ACTIVE") // ACTIVE, CLOSED
  lastScan  String?  // JSON of the last scan
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SystemSetting {
  key   String @id
  value String // JSON stringified
}
